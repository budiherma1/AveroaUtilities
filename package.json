{
  "name": "@averoa/utilities",
  "version": "2.1.2",
  "description": "Model, CRUD, filtering, DB, mail, queue, view and logging utilities for AveroaJS",
  "main": "index.js",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./paths": {
      "types": "./paths.d.ts",
      "default": "./paths.js"
    },
    "./context": {
      "types": "./context.d.ts",
      "default": "./context.js"
    },
    "./Log": {
      "types": "./Log.d.ts",
      "default": "./Log.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./*.d.ts",
      "default": "./*.js"
    },
    "./*": "./*"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "!eslint.config.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiherma1/AveroaUtilities.git"
  },
  "author": "Budi Hermawan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/budiherma1/AveroaUtilities/issues"
  },
  "homepage": "https://github.com/budiherma1/AveroaUtilities#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.7.0",
    "nodemailer": "^10.3.1",
    "validator": "^13.12.0",
    "winston": "^3.13.0"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=10.5.0",
    "croner": "^10.0.0",
    "edge.js": "^5.0.0",
    "knex": "^3.0.0",
    "objection": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "croner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.0",
    "better-sqlite3": "^11.10.0",
    "croner": "^10.0.1",
    "edge.js": "^5.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "knex": "^3.1.0",
    "mysql2": "^3.24.6",
    "objection": "^3.1.5",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
